{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "driyoagung/tes-package-laravel",
    "type": "library",
    "description": "A simple Laravel 12 learning package that exposes a package landing page.",
    "keywords": [
        "laravel",
        "package",
        "learning"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Driyo Agung"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/view": "^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Driyoagung\\TesPackageLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Driyoagung\\TesPackageLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Driyoagung\\TesPackageLaravel\\TesPackageLaravelServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
